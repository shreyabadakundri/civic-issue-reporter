# MongoDB Atlas (optional — without this, reports use data/store.json locally)
MONGODB_URI=
MONGODB_DB_NAME=civicmind

# Optional: Cohere vision + NLP (recommended when you have a Cohere key)
COHERE_API_KEY=
COHERE_VISION_MODEL=command-a-vision-07-2025
COHERE_NLP_MODEL=command-a-03-2025

# Optional: OpenAI vision classification (fallback cloud provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Department notification emails (shown in Admin outbox; optional SMTP to send for real)
DEPT_EMAIL_PUBLIC_WORKS=publicworks@example.com
DEPT_EMAIL_SANITATION=sanitation@example.com
DEPT_EMAIL_SEWER=sewer@example.com
NOTIFY_EMAIL_FALLBACK=ops@civicmind.local

# Optional SMTP (Gmail app password, SendGrid relay, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=civicmind@notifications.local
